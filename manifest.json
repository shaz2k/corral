{
  "manifest_version": 3,
  "name": "Corral — Automatic Tab Groups",
  "version": "1.0.0",
  "description": "Automatically groups your tabs by site, keeps GitHub pull requests together, and flags forgotten ones. Never closes a tab without asking first.",
  "permissions": ["tabs", "tabGroups", "storage", "alarms", "notifications"],
  "optional_host_permissions": ["https://api.github.com/*", "https://github.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Corral",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
